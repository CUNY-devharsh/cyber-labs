#!/bin/sh
# Shows what this machine is.
. /etc/os-release
echo "Machine   Kali in this tab, 64-bit"
echo "System    ${PRETTY_NAME:-Kali} ($(dpkg --print-architecture))"
echo "Kernel    $(uname -sr) $(uname -m)"
echo "Emulator  QEMU compiled to WebAssembly, in your browser"
echo "Memory    $(free -m | awk '/Mem:/{print $2" MB total, "$7" MB free"}')"
echo "Network   none"
echo "Files     ~/labs is shared with the page: Send a file, Get a file, Save my files"
echo "Tools     gdb strace ltrace objdump readelf strings upx r2 yara readpe, gcc g++ java javac python3 (pandas numpy matplotlib flask)"
echo "          nmap tshark tcpdump ssh apache2 nft iptables openssl gpg john hydra aircrack-ng. Run lab-targets for practice targets"
