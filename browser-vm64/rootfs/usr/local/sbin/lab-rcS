#!/bin/sh
# Runs once when the machine starts.
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts -o gid=5,mode=620 devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=0755 tmpfs /run
mkdir -p /run/lock /run/sudo /run/sshd /run/apache2 /var/lock/apache2
hostname kali
cat /etc/hosts.lab > /etc/hosts
ip link set lo up 2>/dev/null
# Let gdb and strace attach to a student's own programs.
echo 0 > /proc/sys/kernel/yama/ptrace_scope 2>/dev/null
echo 3 > /proc/sys/kernel/printk
# The shared folder is opened later by lab-start. Have its driver ready.
modprobe 9pnet_virtio 2>/dev/null
modprobe 9p 2>/dev/null
