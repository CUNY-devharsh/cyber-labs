{
  "name": "Windows Server 2019",
  "service": "windows",
  "containerEnv": {
    "VERSION": "2019"
  },
  "forwardPorts": [
    8006
  ],
  "portsAttributes": {
    "8006": {
      "label": "Windows Server 2019",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "dockerComposeFile": "../windows/compose.yml",
  "initializeCommand": "docker system prune --all --force"
}
