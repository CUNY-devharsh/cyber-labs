{
  "name": "Kali Linux 2026 desktop",
  "build": {
    "dockerfile": "../kali/Dockerfile",
    "context": "../kali",
    "target": "desktop"
  },
  "remoteUser": "kali",
  "init": true,
  "capAdd": [
    "NET_ADMIN",
    "NET_RAW",
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "runArgs": [
    "--hostname=kali",
    "--shm-size=1g",
    "--device=/dev/net/tun"
  ],
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Kali desktop",
      "onAutoForward": "openBrowser"
    },
    "5901": {
      "label": "Desktop internals",
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "start-desktop",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "START-HERE.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh",
            "args": [
              "-l"
            ]
          }
        },
        "workbench.startupEditor": "none",
        "files.exclude": {
          "docs": true,
          "browser-vm": true,
          ".devcontainer": true,
          ".github": true,
          ".gitignore": true
        }
      }
    }
  }
}
