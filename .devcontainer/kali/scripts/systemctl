#!/bin/sh
# systemctl for a dev container. See the Dockerfile for where it comes from.
# Questions about a service (is it running, is it enabled) work without sudo,
# as they do on a real system. Changes still need sudo.
REAL=/usr/lib/lab/systemctl3.py
if [ "$(id -u)" != 0 ]; then
  for a in "$@"; do
    case "$a" in
      -*) continue ;;
      is-active|is-enabled|is-failed|status|show|cat|list-units|list-unit-files|list-dependencies|get-default)
        if sudo -n true 2>/dev/null; then exec sudo -n "$REAL" "$@"; fi ;;
    esac
    break
  done
fi
exec "$REAL" "$@"
