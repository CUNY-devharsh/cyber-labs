#!/bin/bash
# ltrace for both kinds of program on this 32-bit machine.
#
# A 32-bit program goes to the real ltrace. An x86-64 program (the COSC 332
# targets) runs in the lab runner, and gdb watches the calls it makes into
# shared libraries: /usr/local/share/lab/x64-ltrace.py prints each call with
# its arguments and result in ltrace's layout. Supported options: -o FILE,
# -e NAME+NAME, -s SIZE.
real=/usr/bin/ltrace

is_x64() {
  [ -f "$1" ] && [ "$(od -An -tx1 -N5 "$1" 2>/dev/null | tr -d ' \n')" = 7f454c4602 ] \
    && [ "$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' \n')" = 3e00 ]
}

out="" only="" size=32 prog="" args=("$@") i=0
while [ $i -lt ${#args[@]} ]; do
  a=${args[$i]}
  case "$a" in
    -e|-o|-p|-s|-u|-a|-n|-l|-x|-F|-D|-A|-w)
      i=$((i + 1)); v=${args[$i]}
      [ "$a" = -o ] && out=$v
      [ "$a" = -e ] && only=$v
      [ "$a" = -s ] && size=$v ;;
    --output=*) out=${a#--output=} ;;
    --) i=$((i + 1)); prog=${args[$i]}; break ;;
    -*) ;;
    *) prog=$a; break ;;
  esac
  i=$((i + 1))
done
path=$(command -v -- "$prog" 2>/dev/null)
if [ -z "$prog" ] || ! is_x64 "$path"; then exec "$real" "$@"; fi
rest=("${args[@]:$((i + 1))}")
quoted=""
for r in "${rest[@]}"; do quoted="$quoted $(printf '%q' "$r")"; done
export LAB_LT_PROG=$path LAB_LT_ARGS=$quoted LAB_LT_OUT=$out LAB_LT_ONLY=$only LAB_LT_SIZE=$size
[ -z "$out" ] && echo "ltrace: x86-64 program on a 32-bit machine, traced by the lab runner (qemu-x86_64 and gdb)" >&2
exec /usr/bin/gdb -q -nx -batch -x /usr/local/share/lab/x64-ltrace.py
