diff --git a/linux-user/syscall.c b/linux-user/syscall.c
index 549e39e..82b3e46 100644
--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -9185,6 +9185,28 @@ _syscall5(int, sys_move_mount, int, __from_dfd, const char *, __from_pathname,
            int, __to_dfd, const char *, __to_pathname, unsigned int, flag)
 #endif
 
+/*
+ * Lab runner. One program cannot trace another under user-mode emulation, so
+ * ptrace is not implemented. Anti-debugging code calls PTRACE_TRACEME only to
+ * learn whether a debugger is present. Answer the way Linux does: the call
+ * works once when no debugger is attached, and fails with EPERM when one is.
+ */
+bool lab_gdb_used;
+
+static abi_long lab_ptrace(abi_long request)
+{
+    static bool traced;
+
+    if (request != 0) {             /* only PTRACE_TRACEME is answered */
+        return -TARGET_ENOSYS;
+    }
+    if (lab_gdb_used || traced) {
+        return -TARGET_EPERM;
+    }
+    traced = true;
+    return 0;
+}
+
 /* This is an internal helper for do_syscall so that it is easier
  * to have a single return point, so that actions, such as logging
  * of syscall results, can be performed.
@@ -13848,6 +13870,11 @@ static abi_long do_syscall1(CPUArchState *cpu_env, int num, abi_long arg1,
         return do_riscv_hwprobe(cpu_env, arg1, arg2, arg3, arg4, arg5);
 #endif
 
+#ifdef TARGET_NR_ptrace
+    case TARGET_NR_ptrace:
+        return lab_ptrace(arg1);
+#endif
+
     default:
         qemu_log_mask(LOG_UNIMP, "Unsupported syscall: %d\n", num);
         return -TARGET_ENOSYS;
@@ -13877,6 +13904,21 @@ abi_long do_syscall(CPUArchState *cpu_env, int num, abi_long arg1,
     }
 #endif
 
+#if defined(TARGET_X86_64)
+    /*
+     * Lab runner: at the entry stop of a caught system call a real kernel
+     * shows -ENOSYS in RAX. Do the same, then put the call number back, which
+     * a restarted call needs.
+     */
+    if (lab_gdb_used) {
+        CPUX86State *env = cpu_env;
+
+        env->regs[R_EAX] = -TARGET_ENOSYS;
+        record_syscall_start(cpu, num, arg1,
+                             arg2, arg3, arg4, arg5, arg6, arg7, arg8);
+        env->regs[R_EAX] = num;
+    } else
+#endif
     record_syscall_start(cpu, num, arg1,
                          arg2, arg3, arg4, arg5, arg6, arg7, arg8);
 
@@ -13892,6 +13934,21 @@ abi_long do_syscall(CPUArchState *cpu_env, int num, abi_long arg1,
                           arg3, arg4, arg5, arg6);
     }
 
+#if defined(TARGET_X86_64)
+    /*
+     * Lab runner: when gdb stops at the return of a caught system call, show
+     * the result in RAX and keep a value the debugger writes there, as a real
+     * kernel does. Without this RAX still holds the call number at that stop.
+     */
+    if (lab_gdb_used && ret != -QEMU_ERESTARTSYS && ret != -QEMU_ESIGRETURN) {
+        CPUX86State *env = cpu_env;
+
+        env->regs[R_EAX] = ret;
+        record_syscall_return(cpu, num, ret);
+        return env->regs[R_EAX];
+    }
+#endif
+
     record_syscall_return(cpu, num, ret);
     return ret;
 }
